# ─────────────────────────────────────────────────────────────
# Voice Assistant environment configuration
# Copy to .env and fill in real values. Never commit .env.
# ─────────────────────────────────────────────────────────────

# ── LiveKit (Cloud or self-hosted) ──
# From your LiveKit Cloud project settings, or your self-hosted server.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# ── Backend server ──
# Comma-separated list of allowed CORS origins for the widget.
BACKEND_CORS_ORIGINS=http://localhost:5173
# LiveKit access token TTL in seconds (spec: short-lived, ~10 min).
TOKEN_TTL_SECONDS=600

# ── Database (Milestone 5) ──
# Async SQLAlchemy URL. Default points at the docker-compose Postgres+pgvector.
DATABASE_URL=postgresql+asyncpg://voice_assistant:voice_assistant@localhost:5432/voice_assistant

# ── RAG embeddings (Milestone 5) ──
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIM=1536

# ── Agent worker ──
# Deepgram — speech-to-text (Milestone 2). Required for transcription.
DEEPGRAM_API_KEY=your_deepgram_api_key
# STT_MODEL=nova-3
# STT_LANGUAGE=en-US

# Cartesia — text-to-speech (Milestone 3). Required for the agent to speak.
CARTESIA_API_KEY=your_cartesia_api_key
# TTS_MODEL=sonic-3
# TTS_VOICE=f786b574-daa5-4673-aa0c-cbe3e8534c02
# TTS_LANGUAGE=en

# Turn-taking & barge-in (Milestone 4).
# End-of-turn silence (seconds) before the customer's turn is considered done.
# TURN_ENDPOINTING_DELAY=0.7
# Max seconds to wait before force-ending a turn even if speech continues.
# TURN_MAX_DELAY=3.0
# Allow the customer to interrupt the agent mid-response.
# INTERRUPTIONS_ENABLED=true
# Minimum speech length (seconds) that counts as an interruption.
# MIN_INTERRUPTION_DURATION=0.5

# OpenAI — reasoning LLM + policy embeddings (Milestone 5).
OPENAI_API_KEY=your_openai_api_key
# LLM_MODEL=gpt-4.1-mini
# Base URL the agent's tools call for order/policy data.
# BACKEND_URL=http://localhost:8000

# Production hardening (Milestone 7).
# Shared secret protecting the internal order/policy APIs (leave empty for local dev).
# INTERNAL_API_SECRET=change-me-to-a-long-random-string
# Rate limit for POST /api/voice/session per IP.
# RATE_LIMIT_SESSION=10/minute

# Agent persona / greeting (placeholder — see spec 6.4).
# AGENT_NAME=voice-assistant-agent
# AGENT_PERSONA_NAME=Riley
# STORE_NAME=Northwind
# AGENT_GREETING="Hi, I'm Riley from Northwind support. How can I help with your order today?"

# ── Frontend (Vite) ──
# Base URL of the FastAPI backend the widget talks to.
VITE_BACKEND_URL=http://localhost:8000
